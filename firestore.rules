rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == "admin";
    }

    function isApprovedUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/approvedEmails/$(authEmail()));
    }

    match /approvedEmails/{email} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /userProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth.uid == uid
        && request.resource.data.role == "member";
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /readings/{readingId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    match /forecasts/{forecastId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    match /ingestStatus/{cityId} {
      allow read: if isApprovedUser();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
